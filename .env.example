# ---------------------------------------------------------------------------
# Copy to .env in the repository root and replace every secret before running.
# Never commit the resulting .env file.
# ---------------------------------------------------------------------------

# Backend HTTP server
PORT=3001
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# MongoDB (local Community Edition is sufficient)
MONGO_URI=mongodb://127.0.0.1:27017/digital_archaeologist
MONGO_TEST_URI=mongodb://127.0.0.1:27017/digital_archaeologist_test

# Authentication — use two different long random strings
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
REFRESH_COOKIE_MAX_AGE_MS=604800000
COOKIE_SECURE=false

# Local repository storage and import limits (Phase 2)
STORAGE_ROOT=./storage
ANALYZER_VERSION=0.1.0
CLONE_TIMEOUT_MS=180000
MAX_CLONE_SIZE_MB=500
MAX_COMMITS_ANALYZED=2000
MAX_ZIP_SIZE_MB=50
MAX_ZIP_ENTRIES=5000
MAX_ZIP_FILE_SIZE_MB=10
MAX_ZIP_TOTAL_SIZE_MB=200
MAX_SOURCE_FILES_ANALYZED=500
MAX_SOURCE_FILE_SIZE_MB=2
MAX_DIFF_LINES=2000

# AI assistant (Phase 8) — disabled by default; local Ollama only
AI_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
AI_TIMEOUT_MS=30000
AI_MAX_EVIDENCE_ITEMS=20

# Reports (Phase 9)
REPORT_MAX_ITEMS=20

# Frontend (also supports frontend/.env.local)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
