{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node -r ts-node/register src/main.ts",
    "start:dev": "node --watch -r ts-node/register src/main.ts",
    "start:prod": "node dist/main.js",
    "test": "jest --config jest.config.js --runInBand",
    "test:watch": "jest --config jest.config.js --watch",
    "test:e2e": "jest --config test/jest-e2e.config.js --runInBand",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "11.2.11",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.11",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/mongoose": "11.0.4",
    "@nestjs/platform-express": "11.2.11",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "mongoose": "9.12.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "simple-git": "4.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.11",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.19.5",
    "@types/supertest": "7.2.1",
    "jest": "29.7.0",
    "supertest": "7.3.2",
    "ts-jest": "29.3.0",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
